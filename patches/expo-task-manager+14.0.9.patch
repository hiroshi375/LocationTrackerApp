+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] Started keep-alive headless task" +
+          ", appScopeKey=" + appScopeKey +
+          ", taskId=" + taskId +
+          ", keepAliveToken=" + keepAliveToken +
+          ", isRunning=" +
