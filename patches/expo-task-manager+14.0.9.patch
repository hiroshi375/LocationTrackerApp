+  /**
+   * React Native の HeadlessJsTaskContext に task を登録し、
+   * Background中も JS timer が停止しない状態を維持する。
+   */
+  private void maybeStartHeadlessTask(String appScopeKey) {
+    Log.i(
+      TAG,
+      "[HEADLESS_TIMER] maybeStartHeadlessTask ENTER, appScopeKey=" + appScopeKey
+    );
+
+    try {
+      Context context = mContextRef.get();
+
+      if (context == null) {
+        Log.w(
+          TAG,
+          "[HEADLESS_TIMER] context is null, appScopeKey=" + appScopeKey
+        );
+        return;
+      }
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] context available, class=" +
+          context.getClass().getName()
+      );
+
+      ReactContext reactContext = getReactContext(context);
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] getReactContext result=" +
+          (reactContext != null ? "available" : "null") +
+          ", appScopeKey=" + appScopeKey
+      );
+
+      if (reactContext != null) {
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] ReactContext already available -> invokeStartHeadlessTask"
+        );
+
+        invokeStartHeadlessTask(reactContext, appScopeKey);
+      } else {
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] ReactContext unavailable -> waitForReactContextAndStartTask"
+        );
+
+        waitForReactContextAndStartTask(context, appScopeKey);
+      }
+    } catch (Exception e) {
+      Log.e(
+        TAG,
+        "[HEADLESS_TIMER] maybeStartHeadlessTask failed",
+        e
+      );
+    }
+  }
+
+private void invokeStartHeadlessTask(
+  ReactContext reactContext,
+  String appScopeKey
+) {
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] invokeStartHeadlessTask ENTER, appScopeKey=" +
+      appScopeKey
+  );
+
+  HeadlessJsTaskContext headlessContext =
+    HeadlessJsTaskContext.getInstance(reactContext);
+
+  UiThreadUtil.runOnUiThread(() -> {
+    try {
+      /*
+       * 同一appScopeKeyで既にHeadless taskが存在する場合は
+       * 新しいtaskを作成しない。
+       */
+      Integer existingTaskId =
+        sHeadlessTaskIds.get(appScopeKey);
+
+      if (existingTaskId != null) {
+        boolean isRunning =
+          headlessContext.isTaskRunning(existingTaskId);
+
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] keep-alive task already exists" +
+            ", appScopeKey=" + appScopeKey +
+            ", taskId=" + existingTaskId +
+            ", isRunning=" + isRunning
+        );
+
+        /*
+         * Mapには残っているがReact Native上では終了済みだった場合、
+         * stale entryとして削除し、新しいtaskを開始する。
+         */
+        if (isRunning) {
+          return;
+        }
+
+        sHeadlessTaskIds.remove(appScopeKey);
+      }
+
+      WritableNativeMap taskData =
+        new WritableNativeMap();
+
+      taskData.putString(
+        "appScopeKey",
+        appScopeKey
+      );
+
+      /*
+       * timeout=0:
+       *
+       * Headless JS task自身のtimeoutでは終了させず、
+       * Expo background eventがすべて終了した時点で
+       * Native側からfinishTask()を直接呼ぶ。
+       */
+      HeadlessJsTaskConfig taskConfig =
+        new HeadlessJsTaskConfig(
+          "expo-task-manager",
+          taskData,
+          0,
+          true
+        );
+
+      int taskId =
+        headlessContext.startTask(taskConfig);
+
+      sHeadlessTaskIds.put(
+        appScopeKey,
+        taskId
+      );
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] Started keep-alive headless task" +
+          ", appScopeKey=" + appScopeKey +
+          ", taskId=" + taskId +
+          ", isRunning=" +
+          headlessContext.isTaskRunning(taskId) +
+          ", hasActiveTasks=" +
+          headlessContext.hasActiveTasks()
+      );
+
+    } catch (Exception e) {
+      Log.e(
+        TAG,
+        "[HEADLESS_TIMER] Failed to start keep-alive headless task",
+        e
+      );
+    }
+  });
+}
+
+private void waitForReactContextAndStartTask(
+  Context context,
+  String appScopeKey
+) {
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] waitForReactContextAndStartTask ENTER, appScopeKey=" +
+      appScopeKey
+  );
+
+  ReactApplication app =
+    (ReactApplication) context.getApplicationContext();
+
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] ReactApplication class=" +
+      app.getClass().getName()
+  );
+
+  ReactHost reactHost = app.getReactHost();
+
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] ReactHost=" +
+      (reactHost != null ? "available" : "null")
+  );
+
+  if (reactHost == null) {
+    Log.w(
+      TAG,
+      "[HEADLESS_TIMER] ReactHost is null, cannot wait for ReactContext"
+    );
+    return;
+  }
+
+  ReactContext currentReactContext =
+    reactHost.getCurrentReactContext();
+
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] ReactHost currentReactContext=" +
+      (currentReactContext != null ? "available" : "null")
+  );
+
+  if (currentReactContext != null) {
+    Log.i(
+      TAG,
+      "[HEADLESS_TIMER] ReactContext became available before listener registration"
+    );
+
+    invokeStartHeadlessTask(
+      currentReactContext,
+      appScopeKey
+    );
+    return;
+  }
+
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] registering ReactInstanceEventListener"
+  );
+
+  reactHost.addReactInstanceEventListener(
+    new ReactInstanceEventListener() {
+      @Override
+      public void onReactContextInitialized(
+        @NonNull ReactContext reactContext
+      ) {
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] onReactContextInitialized fired, appScopeKey=" +
+            appScopeKey
+        );
+
+        invokeStartHeadlessTask(
+          reactContext,
+          appScopeKey
+        );
+
+        reactHost.removeReactInstanceEventListener(this);
+
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] ReactInstanceEventListener removed"
+        );
+      }
+    }
+  );
+}
+
+/**
+ * そのappScopeKeyに属するBackground eventがすべて終了したら、
+ * timer維持用Headless JS taskをNative側から直接終了する。
+ */
+private void maybeFinishHeadlessTask(
+  String appScopeKey
+) {
+  UiThreadUtil.runOnUiThread(() -> {
+    Integer taskId =
+      sHeadlessTaskIds.remove(appScopeKey);
+
+    if (taskId == null) {
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] no keep-alive task to finish" +
+          ", appScopeKey=" + appScopeKey
+      );
+
+      return;
+    }
+
+    try {
+      Context context = mContextRef.get();
+
+      if (context == null) {
+        Log.w(
+          TAG,
+          "[HEADLESS_TIMER] context unavailable while finishing" +
+            ", appScopeKey=" + appScopeKey +
+            ", taskId=" + taskId
+        );
+
+        return;
+      }
+
+      ReactContext reactContext =
+        getReactContext(context);
+
+      if (reactContext == null) {
+        Log.w(
+          TAG,
+          "[HEADLESS_TIMER] ReactContext unavailable while finishing" +
+            ", appScopeKey=" + appScopeKey +
+            ", taskId=" + taskId
+        );
+
+        return;
+      }
+
+      HeadlessJsTaskContext headlessContext =
+        HeadlessJsTaskContext.getInstance(
+          reactContext
+        );
+
+      boolean runningBeforeFinish =
+        headlessContext.isTaskRunning(taskId);
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER_STATE] before direct finish" +
+          ", appScopeKey=" + appScopeKey +
+          ", taskId=" + taskId +
+          ", isRunning=" + runningBeforeFinish +
+          ", hasActiveTasks=" +
+          headlessContext.hasActiveTasks()
+      );
+
+      if (runningBeforeFinish) {
+        headlessContext.finishTask(taskId);
+      }
+
+      boolean runningAfterFinish =
+        headlessContext.isTaskRunning(taskId);
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] Finished keep-alive headless task directly" +
+          ", appScopeKey=" + appScopeKey +
+          ", taskId=" + taskId +
+          ", wasRunning=" + runningBeforeFinish +
+          ", isRunning=" + runningAfterFinish +
+          ", hasActiveTasks=" +
+          headlessContext.hasActiveTasks()
+      );
+
+    } catch (Exception e) {
+      Log.e(
+        TAG,
+        "[HEADLESS_TIMER] Failed to finish keep-alive headless task directly" +
+          ", appScopeKey=" + appScopeKey +
+          ", taskId=" + taskId,
+        e
+      );
+    }
+  });
+}
+
+/**
+ * 現在のReactContextをReactHostから取得する。
+ */
+@Nullable
+private ReactContext getReactContext(Context context) {
+  ReactApplication app =
+    (ReactApplication) context.getApplicationContext();
+
+  ReactHost reactHost = app.getReactHost();
+
+  return reactHost != null
+    ? reactHost.getCurrentReactContext()
+    : null;
+}
+
 }
