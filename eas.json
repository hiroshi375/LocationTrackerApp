{
    "cli": {
        "version": ">= 20.1.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "env": {
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
            },
            "channel": "preview"
        },
        "production": {
            "autoIncrement": true,
            "environment": "production",
            "android": {
                "buildType": "app-bundle"
            },
            "channel": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
