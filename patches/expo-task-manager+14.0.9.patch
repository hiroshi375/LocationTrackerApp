+private void invokeStartHeadlessTask(
+  ReactContext reactContext,
+  String appScopeKey
+) {
+  Log.i(
+    TAG,
+    "[HEADLESS_TIMER] invokeStartHeadlessTask ENTER, appScopeKey=" +
+      appScopeKey
+  );
+
+  HeadlessJsTaskContext headlessContext =
+    HeadlessJsTaskContext.getInstance(reactContext);
+
+  UiThreadUtil.runOnUiThread(() -> {
+    try {
+      /**
+       * 同一appScopeKeyについてすでにkeep-alive taskが存在するなら、
+       * 二重起動しない。
+       */
+      HeadlessTaskRecord existing =
+        sHeadlessTasks.get(appScopeKey);
+
+      if (existing != null) {
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] keep-alive task already exists" +
+            ", appScopeKey=" + appScopeKey +
+            ", taskId=" + existing.taskId +
+            ", isRunning=" +
+            headlessContext.isTaskRunning(existing.taskId)
+        );
+
+        return;
+      }
+
+      /**
+       * taskごとに一意なtokenを発行する。
+       */
+      String keepAliveToken =
+        UUID.randomUUID().toString();
+
+      WritableNativeMap taskData =
+        new WritableNativeMap();
+
+      taskData.putString(
+        "appScopeKey",
+        appScopeKey
+      );
+
+      taskData.putString(
+        "keepAliveToken",
+        keepAliveToken
+      );
+
+      /**
+       * timeout=0:
