+package expo.modules.location.records
+
+import android.content.Context
+import android.location.Location
+import android.os.Build
+import android.os.SystemClock
+import android.provider.Settings
+import org.json.JSONObject
+import java.util.WeakHashMap
+import java.io.File
+import java.util.UUID
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicLong
+
+/** Diagnostic-only payload. Production package never enables it. No location decisions or I/O per fix. */
+internal object AcLogNativeLocationEvidence {
+  @Volatile private var enabled = false
+  @Volatile private var bootCount: Int? = null
+  private data class Receipt(val elapsed: Long, val wall: Long, val snapshot: String, val source: String, val requestId: String)
+  private val receipts = WeakHashMap<Location, Receipt>()
+  private val processId = UUID.randomUUID().toString()
+  private val eventSequence = AtomicLong()
+  private val receiptSequence = AtomicLong()
+  private var eventFile: File? = null
+  private val writer = Executors.newSingleThreadExecutor()
+
+  // Registration events only: bounded file, no per-fix disk writes or recording-path waits.
+  fun requestEvent(requestId: String, stage: String, request: String? = null) {
+    if (!enabled) return
+    try {
+      val row = JSONObject().put("processId", processId).put("sequence", eventSequence.incrementAndGet())
+        .put("requestId", requestId).put("stage", stage).put("wallTimeMs", System.currentTimeMillis())
+        .put("elapsedRealtimeNanos", SystemClock.elapsedRealtimeNanos().toString())
+        .put("request", request?.take(1024) ?: JSONObject.NULL).toString()
+      writer.execute {
+        try {
+          eventFile?.let { file ->
+            val previous = if (file.exists() && file.length() <= 524288) file.readLines().takeLast(255) else emptyList()
+            val temp = File(file.path + ".tmp")
+            temp.writeText((previous + row).joinToString("\n", postfix = "\n"))
+            if (!temp.renameTo(file)) temp.delete()
+          }
+        } catch (_: Exception) { /* Diagnostic I/O must not affect location delivery. */ }
+      }
+    } catch (_: Exception) { }
+  }
+
+  private fun snapshot(location: Location): String = JSONObject().apply {
+    put("latitude", location.latitude); put("longitude", location.longitude); put("fixTimeMs", location.time)
+    put("fixElapsedRealtimeNanos", location.elapsedRealtimeNanos.toString())
+    put("hasAccuracy", location.hasAccuracy()); put("accuracyMeters", if (location.hasAccuracy()) location.accuracy else JSONObject.NULL)
+    put("hasSpeed", location.hasSpeed()); put("speedMetersPerSecond", if (location.hasSpeed()) location.speed else JSONObject.NULL)
+    val speedAccuracy = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && location.hasSpeedAccuracy()
+    put("hasSpeedAccuracy", speedAccuracy); put("speedAccuracyMetersPerSecond", if (speedAccuracy) location.speedAccuracyMetersPerSecond else JSONObject.NULL)
+    put("provider", location.provider ?: JSONObject.NULL); put("mocked", location.isFromMockProvider)
+    put("receiptId", processId + ":" + receiptSequence.incrementAndGet())
+  }.toString()
+
+  fun received(location: Location, source: String = "foreground", requestId: String = "unknown") {
+    if (!enabled) return
+    try {
+      synchronized(receipts) {
+        if (receipts.size >= 128) receipts.clear()
+        receipts[location] = Receipt(SystemClock.elapsedRealtimeNanos(), System.currentTimeMillis(), snapshot(location), source, requestId)
+      }
+    } catch (_: Exception) { }
+  }
+
+  fun configure(context: Context) {
+    enabled = context.packageName in setOf("com.hiroshisato.locationtrackerapp.incident104", "com.hiroshisato.locationtrackerapp.locationprobe")
+    if (enabled) eventFile = File(context.filesDir, "aclog-location-requests.jsonl")
+    if (enabled && bootCount == null) {
+      bootCount = try { Settings.Global.getInt(context.contentResolver, Settings.Global.BOOT_COUNT) } catch (_: Exception) { null }
+    }
+  }
+
+  fun capture(location: Location): String? {
+    if (!enabled) return null
+    return try {
+      val capturedElapsed = SystemClock.elapsedRealtimeNanos()
+      val receipt = synchronized(receipts) { receipts[location] }
+      val hasSpeedAccuracy = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && location.hasSpeedAccuracy()
+      JSONObject().apply {
+        put("receiptSnapshot", receipt?.let { JSONObject(it.snapshot) } ?: JSONObject.NULL)
+        put("receiptSource", receipt?.source ?: JSONObject.NULL)
+        put("requestId", receipt?.requestId ?: JSONObject.NULL)
+        put("schema", 1)
+        put("captureStage", "native-location-serialization")
+        put("fixTimeMs", location.time)
+        put("latitude", location.latitude)
+        put("longitude", location.longitude)
+        // Strings preserve nanosecond precision through JS/JSON.
+        put("fixElapsedRealtimeNanos", location.elapsedRealtimeNanos.toString())
+        put("capturedElapsedRealtimeNanos", capturedElapsed.toString())
+        put("capturedWallTimeMs", System.currentTimeMillis())
+        put("receivedElapsedRealtimeNanos", receipt?.elapsed?.toString() ?: JSONObject.NULL)
+        put("receivedWallTimeMs", receipt?.wall ?: JSONObject.NULL)
+        put("bootCount", bootCount ?: JSONObject.NULL)
+        put("hasAccuracy", location.hasAccuracy())
+        put("accuracyMeters", if (location.hasAccuracy()) location.accuracy else JSONObject.NULL)
+        put("hasSpeed", location.hasSpeed())
+        put("speedMetersPerSecond", if (location.hasSpeed()) location.speed else JSONObject.NULL)
+        put("hasSpeedAccuracy", hasSpeedAccuracy)
+        put("speedAccuracyMetersPerSecond", if (hasSpeedAccuracy) location.speedAccuracyMetersPerSecond else JSONObject.NULL)
+        put("provider", location.provider ?: JSONObject.NULL)
+        put("mocked", location.isFromMockProvider)
+      }.toString()
+    } catch (_: Exception) { null }
+  }
+}
