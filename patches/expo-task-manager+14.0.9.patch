+            Log.w(
+              TAG,
+              "[HEADLESS_TIMER] keep-alive task still running after 5s;" +
+                " forcing native finish" +
+                ", appScopeKey=" + appScopeKey +
+                ", taskId=" + record.taskId
+            );
