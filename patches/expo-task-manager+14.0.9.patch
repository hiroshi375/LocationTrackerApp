@@ -0,0 +1,38 @@
+package expo.modules.taskManager;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+
+/** Atomic membership: finishing one event must not detach the next event's collection. */
+final class TaskEventRegistry {
+  private final Map<String, Set<String>> events = new HashMap<>();
+
+  synchronized boolean add(String scope, String eventId) {
+    Set<String> pending = events.get(scope);
+    boolean first = pending == null;
+    if (first) {
+      pending = new HashSet<>();
+      events.put(scope, pending);
+    }
+    pending.add(eventId);
+    return first;
+  }
+
+  synchronized boolean finish(String scope, String eventId) {
+    Set<String> pending = events.get(scope);
+    if (pending == null || !pending.remove(eventId)) return false;
+    if (!pending.isEmpty()) return false;
+    events.remove(scope);
+    return true;
+  }
+
+  synchronized boolean hasEvents(String scope) {
+    return events.containsKey(scope);
+  }
+
+  synchronized void removeScope(String scope) {
+    events.remove(scope);
+  }
+}
