@@ -0,0 +1,17 @@
+package expo.modules.taskManager;
+
+/** Preserve the original location job deadline when merging new GPS samples. */
+final class LocationJobDeadline {
+  static final String ENQUEUED_AT = "aclog.location.enqueuedElapsedMs";
+  static final String TASK_NAME = "location-tracker-background-location-task";
+
+  static long age(long now, long enqueuedAt) {
+    // elapsedRealtime can reset after reboot. Do not fabricate a huge age.
+    return enqueuedAt < 0 || enqueuedAt > now ? -1L : now - enqueuedAt;
+  }
+
+  static long remaining(long now, long enqueuedAt, long deadlineMs) {
+    long age = age(now, enqueuedAt);
+    return age < 0 ? deadlineMs : Math.max(0L, deadlineMs - age);
+  }
+}
