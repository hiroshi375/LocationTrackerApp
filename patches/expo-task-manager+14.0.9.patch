+  private void maybeStartHeadlessTask(String appScopeKey) {
+    Log.i(
+      TAG,
+      "[HEADLESS_TIMER] maybeStartHeadlessTask ENTER, appScopeKey=" + appScopeKey
+    );
+
+    try {
+      Context context = getContextOrApplicationContext();
+
+      if (context == null) {
+        Log.w(
+          TAG,
+          "[HEADLESS_TIMER] context is unavailable, appScopeKey=" + appScopeKey
+        );
+        return;
+      }
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] context available, class=" +
+          context.getClass().getName()
+      );
+
+      ReactContext reactContext = getReactContext(context);
+
+      Log.i(
+        TAG,
+        "[HEADLESS_TIMER] getReactContext result=" +
+          (reactContext != null ? "available" : "null") +
+          ", appScopeKey=" + appScopeKey
+      );
+
+      if (reactContext != null) {
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] ReactContext already available -> invokeStartHeadlessTask"
+        );
+
+        invokeStartHeadlessTask(reactContext, appScopeKey);
+      } else {
+        Log.i(
+          TAG,
+          "[HEADLESS_TIMER] ReactContext unavailable -> waitForReactContextAndStartTask"
