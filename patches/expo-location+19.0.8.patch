+package expo.modules.location.records
+
+import android.content.Context
+import android.location.Location
+import org.json.JSONObject
+
+/** Local validation only. Does not read/delete inbox rows or request another position. */
+internal object AcLogSimplifiedLocation {
+  @Volatile private var latest: String? = null
+  fun enabled(context: Context?, options: Map<String, Any>?): Boolean =
+    context?.packageName == "com.hiroshisato.locationtrackerapp.incident104" && options?.get("aclogSimplifiedLocation") == true
+
+  fun publish(location: Location, capturedContext: String) {
+    try {
+      val scope = JSONObject(capturedContext)
+      val coords = JSONObject().put("latitude", location.latitude).put("longitude", location.longitude)
+        .put("accuracy", if (location.hasAccuracy()) location.accuracy else JSONObject.NULL)
+        .put("altitude", if (location.hasAltitude()) location.altitude else JSONObject.NULL)
+        .put("altitudeAccuracy", JSONObject.NULL).put("heading", if (location.hasBearing()) location.bearing else JSONObject.NULL)
+        .put("speed", if (location.hasSpeed()) location.speed else JSONObject.NULL)
+      val point = JSONObject().put("timestamp", location.time).put("coords", coords)
+        .put("aclogNativeEvidence", AcLogNativeLocationEvidence.capture(location) ?: JSONObject.NULL)
+      latest = JSONObject().put("userId", scope.getString("userId"))
+        .put("sessionId", scope.getString("recordingSessionId")).put("location", point).toString()
+    } catch (_: Exception) { }
+  }
+  fun read(context: Context): String? = if (context.packageName == "com.hiroshisato.locationtrackerapp.incident104") latest else null
+}
