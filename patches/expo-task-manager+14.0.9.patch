+      writeHeadlessDiagnostic(
+        "HEADLESS_TIMER_STATE",
+        "appScopeKey=" + appScopeKey +
+          "\ttaskId=" + existingTaskId +
+          "\tisRunning=" + isRunning +
+          "\tstartedAtMs=" + startedAtMs +
+          "\ttaskAgeMs=" + taskAgeMs +
+          "\thasActiveTasks=" +
