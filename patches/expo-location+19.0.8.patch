+package expo.modules.location.taskConsumers
+
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+import android.os.PersistableBundle
+import org.json.JSONArray
+import org.json.JSONObject
+import android.util.Log
+
+/** Private, owner/session-scoped handoff journal. Delete only after JS SQLite acknowledges. */
+class RecordingInbox private constructor(context: Context) : SQLiteOpenHelper(context, "aclog-recording-inbox.db", null, 2) {
+  override fun onCreate(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE points(id INTEGER PRIMARY KEY AUTOINCREMENT, owner TEXT NOT NULL, session TEXT NOT NULL, stamp REAL NOT NULL, lat REAL NOT NULL, lon REAL NOT NULL, context TEXT NOT NULL, payload TEXT NOT NULL, UNIQUE(owner,session,stamp,lat,lon))")
+    db.execSQL("CREATE TABLE sealed(owner TEXT NOT NULL, session TEXT NOT NULL, PRIMARY KEY(owner,session))")
+    createMotionTable(db)
+  }
+  private fun createMotionTable(db: SQLiteDatabase) {
+    db.execSQL("CREATE TABLE IF NOT EXISTS motion_evidence(owner TEXT NOT NULL, session TEXT NOT NULL, stamp REAL NOT NULL, metadata TEXT NOT NULL, PRIMARY KEY(owner,session,stamp))")
+  }
+  override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
+    require(newVersion == 2)
+    if(oldVersion < 2) createMotionTable(db)
+  }
+
+  @Synchronized fun append(contextJson: String, points: List<PersistableBundle>) {
+    val c = JSONObject(contextJson)
+    val owner = c.getString("userId"); val session = c.getString("recordingSessionId")
+    require(owner.isNotBlank() && session.isNotBlank())
+    val start = c.getDouble("startedAtMs")
+    val db = writableDatabase
+    db.beginTransaction()
+    try {
+      val closed = db.rawQuery("SELECT 1 FROM sealed WHERE owner=? AND session=?", arrayOf(owner, session)).use { it.moveToFirst() }
+      if (!closed) for (point in points) {
+        val stamp = point.getDouble("timestamp", Double.NaN)
+        val coords = point.getPersistableBundle("coords") ?: continue
+        val lat = coords.getDouble("latitude", Double.NaN); val lon = coords.getDouble("longitude", Double.NaN)
+        if (!stamp.isFinite() || stamp < start || !lat.isFinite() || !lon.isFinite() || lat !in -90.0..90.0 || lon !in -180.0..180.0) continue
+        db.execSQL("INSERT OR IGNORE INTO points(owner,session,stamp,lat,lon,context,payload) VALUES(?,?,?,?,?,?,?)",
+          arrayOf(owner, session, stamp, lat, lon, contextJson, toJson(point).toString()))
+      }
+      db.setTransactionSuccessful()
+    } finally { db.endTransaction() }
+  }
+
+  @Synchronized fun discardMotion(owner:String,session:String) {
+    seal(owner,session,true)
+    writableDatabase.delete("motion_evidence","owner=? AND session=?",arrayOf(owner,session))
+  }
+
+  @Synchronized fun read(owner: String, session: String): String? {
+    val rows = JSONArray(); var contextJson: String? = null
+    readableDatabase.rawQuery("SELECT id,context,payload FROM points WHERE owner=? AND session=? ORDER BY stamp,id LIMIT 25", arrayOf(owner,session)).use { cursor ->
+      while (cursor.moveToNext()) {
+        if (contextJson == null) contextJson = cursor.getString(1)
+        rows.put(JSONObject().put("id", cursor.getLong(0)).put("location", JSONObject(cursor.getString(2))))
+      }
+    }
+    return contextJson?.let { JSONObject().put("context", JSONObject(it)).put("rows", rows).toString() }
+  }
+
+  @Synchronized fun acknowledge(owner: String, session: String, ids: List<Long>) {
+    require(ids.size <= 25)
+    val db = writableDatabase
+    db.beginTransaction()
+    try {
+      for (id in ids) db.delete("points", "owner=? AND session=? AND id=?", arrayOf(owner,session,id.toString()))
+      db.setTransactionSuccessful()
+    } finally { db.endTransaction() }
+  }
+
+  @Synchronized fun seal(owner: String, session: String, closed: Boolean) {
+    if (closed) writableDatabase.execSQL("INSERT OR IGNORE INTO sealed(owner,session) VALUES(?,?)", arrayOf(owner,session))
+    else writableDatabase.delete("sealed", "owner=? AND session=?", arrayOf(owner,session))
+  }
+
+  @Synchronized fun deleteOwner(owner: String) {
+    val db = writableDatabase; db.beginTransaction()
+    try { db.delete("points", "owner=?", arrayOf(owner)); db.delete("sealed", "owner=?", arrayOf(owner)); db.delete("motion_evidence","owner=?",arrayOf(owner)); db.setTransactionSuccessful() }
+    finally { db.endTransaction() }
+  }
+
+  companion object {
+    @Volatile private var instance: RecordingInbox? = null
+    fun get(context: Context): RecordingInbox = instance ?: synchronized(this) {
+      instance ?: RecordingInbox(context.applicationContext).also { instance = it }
+    }
+    private fun toJson(bundle: PersistableBundle): JSONObject {
+      val result = JSONObject()
+      for (key in bundle.keySet()) {
+        val value = bundle.get(key)
+        result.put(key, if (value is PersistableBundle) toJson(value) else value ?: JSONObject.NULL)
+      }
+      return result
+    }
+  }
+}
