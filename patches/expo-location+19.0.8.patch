+package expo.modules.location.taskConsumers;
+
+/** Bounds live-only dispatches; queued recording jobs are never suppressed. */
+public final class LiveLocationDispatchGate {
+  private long sequence = 0;
+  private long pending = 0;
+  private long startedAt = -1;
+
+  public synchronized long acquire(long elapsedMs) {
+    if (startedAt >= 0 && (elapsedMs - startedAt < 15000 ||
+        (pending != 0 && elapsedMs - startedAt < 45000))) return 0;
+    startedAt = elapsedMs;
+    pending = ++sequence;
+    return pending;
+  }
+
+  public synchronized void finish(long token) {
+    if (pending == token) pending = 0;
+  }
+}
