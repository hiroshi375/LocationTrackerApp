@@ -0,0 +1,18 @@
+package expo.modules.taskManager;
+
+import java.lang.ref.WeakReference;
+import java.util.Map;
+
+/** An older ReactContext must never unregister the replacement context's manager. */
+final class TaskManagerRegistration {
+  static <T> boolean removeIfSame(Map<String, WeakReference<T>> managers, String scope, T destroyed) {
+    synchronized (managers) {
+      WeakReference<T> reference = managers.get(scope);
+      if (reference != null && reference.get() == destroyed) {
+        managers.remove(scope);
+        return true;
+      }
+      return false;
+    }
+  }
+}
